{
  "name": "lumo-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @lumo-ui/website dev",
    "build": "pnpm -r build",
    "verify": "pnpm run gate:types && pnpm run gate:no-css-modules && pnpm run gate:test",
    "gate:types": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "gate:no-css-modules": "node scripts/no-css-modules.mjs",
    "typecheck": "pnpm run gate:types",
    "test": "pnpm -r --if-present test",
    "gate:test": "pnpm -r --if-present run test",
    "gate:html": "node --experimental-strip-types packages/gate/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
