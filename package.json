{
  "name": "lumo-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @lumo-ui/website dev",
    "build": "pnpm -r --if-present run build",
    "start": "node scripts/serve-static.mjs",
    "preview": "pnpm run build && pnpm run start",
    "verify": "pnpm run gate:types && pnpm run gate:no-css-modules && pnpm run gate:test && pnpm run gate:registry && pnpm run gate:smoke && pnpm run gate:html",
    "gate:types": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "gate:no-css-modules": "node scripts/no-css-modules.mjs",
    "typecheck": "pnpm run gate:types",
    "test": "pnpm -r --if-present test",
    "gate:test": "pnpm -r --if-present run test",
    "gate:html": "pnpm --filter @lumo-ui/website build && node --experimental-strip-types packages/gate/src/cli.ts apps/website/out",
    "gate:registry": "node scripts/build-registry.mjs && git diff --exit-code registry.json",
    "gate:smoke": "node scripts/smoke-consumer.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
