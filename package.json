{
  "name": "lumo-ui",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @lumo-ui/website dev",
    "build": "pnpm -r --if-present run build",
    "start": "node scripts/serve-static.mjs",
    "preview": "pnpm run build && pnpm run start",
    "verify": "pnpm run gate:versions && pnpm run gate:types && pnpm run gate:consumer-profile && pnpm run gate:consumer-lint && pnpm run gate:dist && pnpm run gate:pack && pnpm run gate:flutter-tokens && pnpm run gate:mobile-styles && pnpm run gate:flutter && pnpm run gate:flutter-contract && pnpm run gate:mobile-demos && pnpm run gate:mobile-api && pnpm run gate:mobile-smoke && pnpm run gate:props && pnpm run gate:lint && pnpm run gate:no-css-modules && pnpm run gate:test && pnpm run gate:registry && pnpm run gate:api && pnpm run gate:catalog && pnpm run gate:smoke && pnpm run gate:html",
    "gate:types": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "gate:props": "node --experimental-strip-types packages/gate/src/inert-props-cli.ts packages/ui/src packages/blocks/src",
    "lint": "eslint .",
    "gate:lint": "eslint .",
    "gate:no-css-modules": "node scripts/no-css-modules.mjs",
    "typecheck": "pnpm run gate:types",
    "test": "pnpm -r --if-present test",
    "gate:test": "pnpm -r --if-present run test",
    "gate:html": "pnpm --filter @lumo-ui/website build && node --experimental-strip-types packages/gate/src/cli.ts apps/website/out apps/website/gate.floors.json",
    "gate:registry": "node scripts/build-registry.mjs --check",
    "build:api": "node scripts/build-api-reference.mjs",
    "gate:api": "node scripts/build-api-reference.mjs --check",
    "gate:smoke": "node scripts/smoke-consumer.mjs",
    "mutation:components": "node scripts/mutate-components.mjs --output mutation-report.json",
    "mutation:mobile": "node scripts/mutate-mobile.mjs",
    "evidence": "playwright test -c evidence/playwright.config.ts",
    "evidence:types": "tsc -p evidence/tsconfig.json",
    "catalog": "node scripts/build-catalog.mjs",
    "gate:catalog": "node scripts/build-catalog.mjs --check",
    "gate:versions": "node scripts/check-versions.mjs",
    "gate:consumer-profile": "tsc -p tsconfig.consumer-profile.json",
    "gate:consumer-lint": "eslint -c eslint.consumer.config.mjs --max-warnings 0 \"packages/ui/src/**/*.{ts,tsx}\" \"packages/blocks/src/**/*.{ts,tsx}\"",
    "build:gate": "tsc -p packages/gate/tsconfig.dist.json",
    "gate:dist": "node scripts/check-gate-dist.mjs",
    "gate:pack": "node scripts/check-pack.mjs",
    "gate:flutter-tokens": "node scripts/build-flutter-tokens.mjs --check",
    "gate:flutter": "node scripts/flutter-gate.mjs",
    "gate:flutter-contract": "node scripts/flutter-contract-gate.mjs --self-test && node scripts/flutter-contract-gate.mjs",
    "build:mobile-demos": "node scripts/build-mobile-demos.mjs",
    "gate:mobile-demos": "node scripts/build-mobile-demos.mjs --check",
    "build:mobile-gallery": "node scripts/build-mobile-gallery.mjs",
    "build:mobile-api": "node scripts/build-mobile-api.mjs",
    "gate:mobile-api": "node scripts/build-mobile-api.mjs --check",
    "build:mobile-styles": "node scripts/build-mobile-styles.mjs",
    "gate:mobile-styles": "node scripts/build-mobile-styles.mjs --check",
    "gate:mobile-smoke": "node scripts/smoke-mobile.mjs"
  },
  "dependencies": {
    "dom-accessibility-api": "0.7.1",
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lumo-ui/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "bin": {
    "lumo": "scripts/lumo-cli.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "scripts/lumo-cli.mjs",
    "scripts/lib/**",
    "scripts/build-catalog.mjs",
    "packages/*/package.json",
    "packages/*/src/**",
    "packages/gate/dist/**",
    "registry.json",
    "catalog.json",
    "api-reference.json",
    "pnpm-workspace.yaml",
    "docs/agent-consumer.md",
    "docs/i18n-and-rtl.md",
    "skills/**",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ]
}
