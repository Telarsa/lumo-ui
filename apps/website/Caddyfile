{
  admin off
  auto_https off
}

(security_headers) {
  header {
    Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=()"
    Cross-Origin-Opener-Policy "same-origin"
    -Server
  }
}

:3000 {
  root * /srv
  encode zstd gzip
  import security_headers
  # Cloudflare's own files (public/_headers, public/_redirects) are not pages.
  @internal path /_headers /_redirects
  respond @internal 404
  @immutable path /_next/static/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  handle / {
    header Vary Accept-Language
    header Cache-Control no-store
    @fa header_regexp Accept-Language ^\s*fa
    redir @fa /fa/ 302
    @de header_regexp Accept-Language ^\s*de
    redir @de /de/ 302
    redir /en/ 302
  }
  handle_errors {
    @missing expression {http.error.status_code} == 404
    handle @missing {
      rewrite * /404.html
      file_server
    }
  }
  file_server
}
