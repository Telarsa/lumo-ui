# Optional marketing canonical origin. Leave unset before deployment is agreed.
NEXT_PUBLIC_SITE_URL=

# Private Persian font (IRANSansX). A directory holding IRANSansXVF.woff2 and
# IRANSansX-LICENSE-NOTE.txt; copied into the git-ignored
# src/assets/fonts/private/ and verified against docs/site-assets.json before
# dev, lint, typecheck and build. Leave unset for a public build (system
# Persian fallback). Never commit the font. Set LUMO_REQUIRE_PRIVATE_FONTS=1 to
# fail instead of falling back (production image).
LUMO_PRIVATE_FONTS_DIR=
LUMO_REQUIRE_PRIVATE_FONTS=
