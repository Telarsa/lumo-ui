# JetBrains project files for the Dart apps — per-developer, never shared.
.idea/
*.iml


# Flutter build output — machine-specific, and Generated.xcconfig /
# flutter_export_environment.sh embed the SDK's absolute path on whichever
# machine ran the build. A `git add -A` sweeps them in silently.
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Flutter/Flutter.podspec
**/ios/.symlinks/
**/ios/Runner/GeneratedPluginRegistrant.*
**/android/local.properties

# Next regenerates this on every build; carrying it only creates diff noise.
next-env.d.ts
